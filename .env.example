# ---------------------------------------------------------------------------
# Domain Monitor - central server configuration
# Copy to .env and adjust. All values have working defaults.
# ---------------------------------------------------------------------------

# Port the dashboard is published on. 8082 keeps it clear of the server
# monitoring dashboard, which uses 8080.
FRONTEND_PORT=8082

# Where Nginx forwards /api and /ws. Leave as-is for the bundled agent.
AGENT_ADDR=agent:9292

# --- Probe cadence ---------------------------------------------------------
# Reachability is the only check that needs to be frequent. Certificates and
# domain registrations change on the scale of months.
HTTP_INTERVAL=60s
TLS_INTERVAL=6h
DNS_INTERVAL=15m
RDAP_INTERVAL=12h

# How many checks may run at once.
PROBE_CONCURRENCY=8

# Per-probe timeouts. Raise these if the server sits further from the monitored
# sites than the machine these defaults were measured on - a probe that times
# out is reported as DOWN, so a too-tight timeout invents outages.
HTTP_TIMEOUT=10s
TLS_TIMEOUT=8s
DNS_TIMEOUT=5s
RDAP_TIMEOUT=15s

# --- Thresholds ------------------------------------------------------------
# The agent classifies every status, so these are the single definition of
# "degraded" shared by the wall, the table and the detail view.
LATENCY_WARN_MS=800
LATENCY_CRIT_MS=2000
CERT_WARN_DAYS=30
CERT_CRIT_DAYS=14
DOMAIN_WARN_DAYS=60
DOMAIN_CRIT_DAYS=30

# Non-2xx status codes that still count as healthy. An API or CDN root that
# answers 401 or 403 is working as designed. Add 404 for hosts that genuinely
# have no page at / - otherwise they sit amber forever and train people to
# ignore the colour that matters.
ACCEPT_STATUS=401,403

# --- Storage ---------------------------------------------------------------
# How long raw checks are kept. Incidents are kept far longer regardless.
RETENTION_DAYS=30

# --- Security --------------------------------------------------------------
# Leave empty for an open dashboard on a trusted network. If set, the frontend
# needs the same value in frontend/.env as VITE_API_TOKEN.
API_TOKEN=

LOG_LEVEL=info
TZ=Asia/Jakarta

# --- Webhook alerting (optional) ------------------------------------------
# Posts each incident to a webhook, e.g. an n8n workflow that screenshots
# CAPTURE_URL and forwards it to Telegram and/or WhatsApp.
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_CHANNEL=both
WEBHOOK_CHAT_ID=
WEBHOOK_WA_RECIPIENT=
CAPTURE_URL=http://localhost:8082/
