# Nginx configuration for the dashboard container.
#
# Rendered by the official image entrypoint: each placeholder matching a real
# environment variable is substituted at startup. Nginx's own runtime variables
# ($host, $remote_addr, $http_upgrade, ...) are left alone, because the
# entrypoint passes envsubst an explicit list of defined variables rather than
# letting it rewrite every dollar sign it finds.
#
# Unlike the server dashboard, there is exactly one upstream here: a single
# agent checks every domain and subdomain from the outside.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    # The ECharts chunk is ~500 KB raw and ~169 KB gzipped, which is the
    # difference between an instant and a sluggish first paint on a TV that
    # has just been switched on.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    # -----------------------------------------------------------------------
    # Static dashboard
    # -----------------------------------------------------------------------
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;

        # Safe to cache hard: Vite fingerprints these filenames.
        location ~* \.(js|css|woff|woff2|ttf|eot|ico)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }

    # -----------------------------------------------------------------------
    # Agent REST API
    #
    # Every response is live state; caching one would freeze the numbers on
    # screen while the estate behind them changed.
    # -----------------------------------------------------------------------
    location /api/ {
        proxy_pass http://${AGENT_ADDR}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
        proxy_buffering off;
    }

    # -----------------------------------------------------------------------
    # Agent WebSocket
    #
    # The long read timeout is deliberate: this connection is meant to stay
    # open for weeks on a wall display, and a shorter timeout would drop every
    # dashboard on a timer whenever the estate was quiet.
    # -----------------------------------------------------------------------
    location /ws/ {
        proxy_pass http://${AGENT_ADDR}/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # -----------------------------------------------------------------------
    # Prometheus Proxy (Historical Metrics & SLA: 24h, 7d, 30d, 90d, 1th)
    # -----------------------------------------------------------------------
    location /prometheus/api/ {
        proxy_pass http://${PROMETHEUS_ADDR}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
