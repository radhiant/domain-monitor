# Domain Monitor - konfigurasi agent (instalasi langsung di server)
#
# Salin ke /etc/domain-monitor/domain-monitor.env
#
# File ini dibaca SETELAH nilai default di unit systemd, jadi apa pun yang
# ditulis di sini menang. Baris yang tidak dipakai cukup dikomentari - nilai
# defaultnya sudah wajar untuk sebagian besar kasus.
#
# Setelah mengubah file ini:  sudo systemctl restart domain-monitor
# Mengubah list-domain.txt TIDAK perlu restart (dibaca ulang otomatis <30 dtk).

# --- Dasar -----------------------------------------------------------------
# Alamat listen. Biarkan :9292 agar bisa dijangkau container dashboard.
# Kalau dashboard berada di mesin yang sama dan Anda ingin menutupnya dari LAN,
# ganti ke 127.0.0.1:9292 - tapi container Docker tidak akan bisa menjangkaunya.
#HTTP_ADDR=:9292

#TARGETS_FILE=/etc/domain-monitor/list-domain.txt
#DB_PATH=/var/lib/domain-monitor/domain-monitor.db

# --- Irama pemeriksaan ------------------------------------------------------
#HTTP_INTERVAL=60s
#TLS_INTERVAL=6h
#DNS_INTERVAL=15m
#RDAP_INTERVAL=12h
#PROBE_CONCURRENCY=8

# --- Timeout ----------------------------------------------------------------
# Naikkan hanya jika situsnya memang lambat dari lokasi server. Menaikkan ini
# untuk menutupi masalah jaringan hanya akan menyamarkan gangguan yang nyata.
#HTTP_TIMEOUT=10s
#TLS_TIMEOUT=8s
#DNS_TIMEOUT=5s
#RDAP_TIMEOUT=15s

# --- Ambang batas -----------------------------------------------------------
#LATENCY_WARN_MS=800
#LATENCY_CRIT_MS=2000
#CERT_WARN_DAYS=30
#CERT_CRIT_DAYS=14
#DOMAIN_WARN_DAYS=60
#DOMAIN_CRIT_DAYS=30

# Kode non-2xx yang tetap dianggap sehat. Tambahkan 404 untuk host API yang
# memang tidak punya halaman di "/" (mis. api-app.example.org).
#ACCEPT_STATUS=401,403

# Berapa kali gagal berturut-turut sebelum insiden dibuka.
#FAIL_THRESHOLD=2

# --- Penyimpanan ------------------------------------------------------------
#RETENTION_DAYS=30

# --- Keamanan ---------------------------------------------------------------
# Isi kalau agent bisa dijangkau dari jaringan yang tidak tepercaya. Nilai yang
# sama harus dipasang di dashboard sebagai VITE_API_TOKEN saat build.
#API_TOKEN=

# Batasi origin yang boleh mengakses API. Default "*" aman untuk LAN tertutup.
#CORS_ORIGINS=*

#LOG_LEVEL=info
